#!/usr/bin/env bash
# Start the booking-gallery worker (previews, thumbnails, EXIF/GPS). Run it next to ./start.
# Usage: bash ./start-worker
set -euo pipefail
cd "$(dirname "$0")"

if [ ! -f .env ]; then
  echo "backend/.env is missing: the worker needs SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY." >&2
  exit 1
fi

if [ ! -x .venv/bin/python ]; then
  echo "Creating .venv"
  python3 -m venv .venv
fi

# Reinstall only when requirements.txt changes.
stamp=.venv/.requirements.sha256
want=$(sha256sum requirements.txt | cut -d' ' -f1)
if [ "$(cat "$stamp" 2>/dev/null)" != "$want" ]; then
  echo "Installing requirements"
  .venv/bin/pip install -q --disable-pip-version-check -r requirements.txt
  echo "$want" > "$stamp"
fi

exec .venv/bin/python -m worker
