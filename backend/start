#!/usr/bin/env bash
# Start the FastAPI backend on port 8001 (8000 is the ML service).
# Usage: bash ./start   (extra arguments go to uvicorn, e.g. --host 0.0.0.0 for the LAN)
set -euo pipefail
cd "$(dirname "$0")"

if [ ! -f .env ]; then
  echo "backend/.env is missing: it needs SUPABASE_URL and SUPABASE_KEY." >&2
  exit 1
fi

if [ ! -x .venv/bin/python ]; then
  echo "Creating .venv"
  python3 -m venv .venv
fi

# Reinstall only when requirements.txt changes.
stamp=.venv/.requirements.sha256
want=$(sha256sum requirements.txt | cut -d' ' -f1)
if [ "$(cat "$stamp" 2>/dev/null)" != "$want" ]; then
  echo "Installing requirements"
  .venv/bin/pip install -q --disable-pip-version-check -r requirements.txt
  echo "$want" > "$stamp"
fi

exec .venv/bin/uvicorn main:app --reload --port 8001 "$@"
